# Sources are bundled into dist/; ship only the bundles and runtime assets.
src/**
test/**
scripts/**
node_modules/**
coverage/**
work/**
.vsix-verify-temp/**
.stdlib-temp/**

# The standard-library source; the build copies it to dist/stdlib/, which is
# what the worker reads. Shipping both would duplicate half a megabyte.
assets/**

# Agent/editor configuration and local tooling output. vsce ignores
# .gitignore entirely whenever this file exists, so anything a tool drops
# into the repo root ships unless it is listed here.
.claude/**
.clipshot/**

# Development configuration
.vscode/**
.github/**
.gitignore
tsconfig.json
eslint.config.mjs
vitest.config.ts
package-lock.json

# Docs that live on GitHub, not in the package (README/LICENSE/CHANGELOG ship automatically)
# THIRD_PARTY_NOTICES.md and third-party/ must NOT be added here: the licences of
# the code we bundle require their notices to travel with the VSIX.
CONTRIBUTING.md
SECURITY.md
CODE_OF_CONDUCT.md
sample.md
docs/**

# Build noise
**/*.map
*.vsix
