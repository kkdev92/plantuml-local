{
  "name": "plantuml-local",
  "displayName": "PlantUML Local",
  "description": "%extension.description%",
  "version": "0.11.1",
  "publisher": "kkdev92",
  "author": {
    "name": "kkdev92",
    "url": "https://kkdev92.dev/"
  },
  "license": "MIT",
  "homepage": "https://kkdev92.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/kkdev92/plantuml-local"
  },
  "bugs": {
    "url": "https://github.com/kkdev92/plantuml-local/issues"
  },
  "engines": {
    "vscode": "^1.138.0",
    "node": ">=24.0.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "plantuml",
    "uml",
    "diagram",
    "markdown",
    "preview",
    "offline",
    "sequence-diagram",
    "wasm"
  ],
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1b1b1b",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Diagrams are rendered locally in a worker thread; the extension reads no workspace files and makes no network requests. The export commands are the only actions that write files or edit the document, and they are disabled here."
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/plantuml.css"
    ],
    "languages": [
      {
        "id": "plantuml",
        "aliases": [
          "PlantUML",
          "plantuml"
        ],
        "extensions": [
          ".puml",
          ".plantuml",
          ".pu",
          ".iuml",
          ".wsd"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "plantuml",
        "scopeName": "source.plantuml-local",
        "path": "./dist/syntaxes/plantuml.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.json": "json",
          "meta.embedded.block.yaml": "yaml"
        }
      },
      {
        "scopeName": "markdown.plantuml-local.codeblock",
        "path": "./dist/syntaxes/markdown-plantuml.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.plantuml": "plantuml",
          "meta.embedded.block.json": "json",
          "meta.embedded.block.yaml": "yaml"
        }
      },
      {
        "scopeName": "markdown.plantuml-local.codeblock-fallback",
        "path": "./dist/syntaxes/markdown-plantuml-fallback.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.plantuml": "plantuml",
          "meta.embedded.block.json": "json",
          "meta.embedded.block.yaml": "yaml"
        }
      },
      {
        "scopeName": "plantuml-local.data-injection",
        "path": "./dist/syntaxes/plantuml-data.tmLanguage.json",
        "injectTo": [
          "text.html.markdown",
          "source.plantuml-local"
        ]
      },
      {
        "scopeName": "plantuml-local.json-injection",
        "path": "./dist/syntaxes/plantuml-json.tmLanguage.json",
        "injectTo": [
          "text.html.markdown",
          "source.plantuml-local"
        ]
      }
    ],
    "commands": [
      {
        "command": "plantumlLocal.clearCache",
        "title": "%command.clearCache.title%",
        "category": "PlantUML Local"
      },
      {
        "command": "plantumlLocal.exportSvg",
        "title": "%command.exportSvg.title%",
        "category": "PlantUML Local"
      },
      {
        "command": "plantumlLocal.exportAllSvg",
        "title": "%command.exportAllSvg.title%",
        "category": "PlantUML Local"
      },
      {
        "command": "plantumlLocal.exportAllAndUpdateRefs",
        "title": "%command.exportAllAndUpdateRefs.title%",
        "category": "PlantUML Local"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "plantumlLocal.exportSvg",
          "when": "editorLangId == markdown && plantumlLocal.cursorInDiagram",
          "group": "2_plantuml@1"
        },
        {
          "command": "plantumlLocal.exportAllSvg",
          "when": "editorLangId == markdown && plantumlLocal.hasDiagrams",
          "group": "2_plantuml@2"
        },
        {
          "command": "plantumlLocal.exportAllAndUpdateRefs",
          "when": "editorLangId == markdown && plantumlLocal.hasDiagrams",
          "group": "2_plantuml@3"
        }
      ]
    },
    "configuration": {
      "title": "PlantUML Local",
      "properties": {
        "plantumlLocal.theme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "default": "auto",
          "description": "%config.theme.description%"
        },
        "plantumlLocal.logLevel": {
          "type": "string",
          "enum": [
            "trace",
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info",
          "description": "%config.logLevel.description%"
        },
        "plantumlLocal.exportDirectory": {
          "type": "string",
          "default": "images",
          "description": "%config.exportDirectory.description%"
        },
        "plantumlLocal.exportTheme": {
          "type": "string",
          "enum": [
            "light",
            "dark",
            "preview"
          ],
          "default": "light",
          "description": "%config.exportTheme.description%"
        },
        "plantumlLocal.hideExportedImages": {
          "type": "boolean",
          "default": true,
          "description": "%config.hideExportedImages.description%"
        },
        "plantumlLocal.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "%config.diagnostics.enabled.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle:prod",
    "bundle": "node scripts/build.mjs",
    "bundle:prod": "node scripts/build.mjs --production",
    "bundle:watch": "node scripts/build.mjs --watch",
    "generate:stdlib": "node scripts/generate-stdlib.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "npm run bundle && vitest run --project integration",
    "test:coverage": "vitest run --project unit --coverage",
    "package": "vsce package --no-dependencies --out plantuml-local.vsix",
    "verify:vsix": "node scripts/verify-vsix.mjs",
    "install-local": "npm run package && code --install-extension plantuml-local.vsix --force",
    "uninstall-local": "code --uninstall-extension kkdev92.plantuml-local",
    "clean": "rimraf dist coverage .vsix-verify-temp .stdlib-temp"
  },
  "dependencies": {
    "@kkdev92/vscode-ext-kit": "^7.0.0",
    "@plantuml/core": "1.2026.8",
    "happy-dom": "^20.14.5",
    "markdown-it": "^14.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.0",
    "@types/vscode": "~1.138.0",
    "@vitest/coverage-v8": "^5.0.2",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.11.0",
    "rimraf": "^6.1.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.0",
    "vscode-oniguruma": "1.7.0",
    "vscode-textmate": "^9.3.2"
  }
}
